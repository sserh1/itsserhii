---
import { site } from '../site';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'blog', active: path === '/' || path.startsWith('/posts/') },
  { href: '/books/', label: 'books', active: path.startsWith('/books') },
  { href: '/about/', label: 'about', active: path.startsWith('/about') },
];
---

<header class="nav column">
  <a class="logo" href="/">
    {site.title}{site.caret && <span class="caret" aria-hidden="true"></span>}
  </a>
  <nav>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 96px;
  }

  .logo {
    font-size: 15px;
    line-height: 1;
    font-weight: 700;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: 28px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  nav a {
    font-size: 14px;
    line-height: 1;
    color: var(--muted);
    text-decoration: none;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration-line: underline;
  }

  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.2em;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .nav {
      height: 72px;
    }

    ul {
      gap: 20px;
    }
  }
</style>
