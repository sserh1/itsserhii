---
// Header band with the grid texture, closed by a row rule.
// Pass `path` for a plain `~/path` title, or put custom content in the slot
// (a post's meta and title): it is centred in a band of the same height.
// `art` centers the slot in a fixed-height band, for artwork instead of text.
import Rule from './Rule.astro';

interface Props {
  path?: string;
  art?: boolean;
}

const { path, art = false } = Astro.props;
---

<header class:list={['band', { art, fitted: !path && !art }]}>
  <div class="column">
    {path ? <h1><span class="prefix">~/</span>{path}</h1> : <slot />}
  </div>
</header>
<Rule />

<style>
  .band {
    --height: calc(104px + 72px + 32px * 1.3); /* padding + one line of title */
    position: relative;
    padding-block: 104px 72px;
  }

  .band::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 16px 16px;
    mask-image: linear-gradient(to bottom, #000, rgba(0, 0, 0, 0.15));
    pointer-events: none;
  }

  .column {
    position: relative;
  }

  .prefix {
    color: var(--muted);
    font-weight: 400;
  }

  /* Same height as a `~/path` band; only a very long title makes it grow. */
  .fitted {
    display: grid;
    align-items: center;
    min-height: var(--height);
    padding-block: 32px;
  }

  /* As tall as a post header with a two-line title: padding + meta + gap + title. */
  .art {
    display: grid;
    align-items: center;
    height: calc(104px + 72px + 13px * 1.5 + 16px + 2 * 32px * 1.3);
    padding-block: 0;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .band {
      --height: calc(64px + 48px + 26px * 1.3);
      padding-block: 64px 48px;
    }

    .fitted {
      padding-block: 20px;
    }

    .art {
      height: calc(64px + 48px + 13px * 1.5 + 16px + 2 * 26px * 1.3);
      padding-block: 0;
    }
  }
</style>
