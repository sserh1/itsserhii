---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Contacts from '../components/Contacts.astro';
import { Content, frontmatter } from '../content/about.md';

const now = Object.entries<string>(frontmatter.now ?? {});
---

<Base>
  <PageHeader path="about" />
  <article class="column content prose">
    <Content />

    {
      now.length > 0 && (
        <>
          <h2>now</h2>
          <dl>
            {now.map(([label, value]) => (
              <>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </>
            ))}
          </dl>
        </>
      )
    }
  </article>
  <Contacts slot="footer-left" />
</Base>

<style>
  dl {
    display: grid;
    grid-template-columns: 12ch 1fr;
    gap: 8px 2ch;
  }

  dt {
    color: var(--muted);
  }
</style>
