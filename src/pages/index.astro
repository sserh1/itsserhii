---
import Base from '../layouts/Base.astro';
import { formatDate, formatTags, getPosts, postUrl } from '../lib/posts';

const posts = await getPosts();
---

<Base>
  <div class="column content">
    <ul class="posts">
      {
        posts.map((post) => (
          <li>
            <a href={postUrl(post)}>
              <time class="date" datetime={formatDate(post.data.date)}>
                {formatDate(post.data.date)}
              </time>
              <span class="title">{post.data.title}</span>
              <span class="tags">{formatTags(post.data.tags)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .posts {
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: 10ch 1fr auto;
    gap: 2ch;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
    text-decoration: none;
  }

  .date,
  .tags {
    color: var(--muted);
    font-size: 13px;
  }

  .title {
    font-size: 15px;
    line-height: 1.5;
  }

  a:hover .title {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    a {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'date tags'
        'title title';
      row-gap: 4px;
    }

    .date {
      grid-area: date;
    }

    .tags {
      grid-area: tags;
      text-align: right;
    }

    .title {
      grid-area: title;
    }
  }
</style>
