---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { Content, frontmatter } from '../content/about.md';

// Profile URLs for `@handle` values, by label.
const handles: Record<string, string> = {
  tg: 'https://t.me/',
  telegram: 'https://t.me/',
  x: 'https://x.com/',
  twitter: 'https://x.com/',
};

// https://github.com/sserh1 -> github.com/sserh1, hi@x.dev -> mailto:, @name -> t.me/name for `tg`.
function contact(label: string, value: string) {
  if (/^https?:\/\//.test(value)) return { href: value, text: value.replace(/^https?:\/\//, '') };
  if (value.startsWith('@') && handles[label]) return { href: handles[label] + value.slice(1), text: value };
  if (value.includes('@')) {
    const email = value.replace(/^mailto:/, '');
    return { href: `mailto:${email}`, text: email };
  }
  return { href: value, text: value };
}

const now = Object.entries<string>(frontmatter.now ?? {});
const elsewhere = Object.entries<string>(frontmatter.elsewhere ?? {}).map(([label, value]) => ({
  label,
  ...contact(label, value),
}));
---

<Base title="about">
  <PageHeader path="about" />
  <article class="column content prose">
    <Content />

    {
      now.length > 0 && (
        <>
          <h2>now</h2>
          <dl>
            {now.map(([label, value]) => (
              <>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </>
            ))}
          </dl>
        </>
      )
    }

    {
      elsewhere.length > 0 && (
        <>
          <h2>elsewhere</h2>
          <dl>
            {elsewhere.map(({ label, href, text }) => (
              <>
                <dt>{label}</dt>
                <dd>
                  <a href={href}>{text}</a>
                </dd>
              </>
            ))}
          </dl>
        </>
      )
    }
  </article>
</Base>

<style>
  dl {
    display: grid;
    grid-template-columns: 12ch 1fr;
    gap: 8px 2ch;
  }

  dt {
    color: var(--muted);
  }
</style>
