---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { formatDate, formatTags, getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, tags } = post.data;
const { Content } = await render(post);
---

<Base title={title}>
  <PageHeader>
    <p class="meta">
      <time datetime={formatDate(date)}>{formatDate(date)}</time>{tags.length > 0 && ` · ${formatTags(tags)}`}
    </p>
    <h1>{title}</h1>
  </PageHeader>
  <article class="column content prose">
    <Content />
  </article>
  <a slot="footer-left" href="/blog/">← all posts</a>
</Base>

<style>
  .meta {
    margin-bottom: 16px;
  }
</style>
